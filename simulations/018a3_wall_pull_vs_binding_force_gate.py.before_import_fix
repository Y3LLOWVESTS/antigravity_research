def odd_grid_count(
    box_half: float,
    requested_dx: float,
) -> int:
    """Return an odd grid count near the requested uniform spacing."""

    n = int(
        round(
            2.0
            *
            box_half
            /
            requested_dx
        )
    ) + 1

    if n % 2 == 0:
        n += 1

    return max(
        n,
        101,
    )


def extract_radial_fields(
    solution,
    radius: np.ndarray,
    profile_rmax: float,
) -> tuple[
    np.ndarray,
    np.ndarray,
]:
    """Evaluate f(r) and rho(r), extending them by vacuum outside the BVP."""

    flat = radius.ravel()

    clipped = np.clip(
        flat,
        core_mod.R0,
        profile_rmax,
    )

    values = solution.sol(
        clipped
    )

    f = values[0].reshape(
        radius.shape
    )

    rho = values[6].reshape(
        radius.shape
    )

    inside_axis = (
        radius
        <
        core_mod.R0
    )

    outside = (
        radius
        >
        profile_rmax
    )

    f = np.array(
        f,
        copy=True,
    )

    rho = np.array(
        rho,
        copy=True,
    )

    f[inside_axis] = 0.0
    rho[inside_axis] = 0.0

    f[outside] = (
        core_mod.ETA_PHI
    )

    rho[outside] = (
        core_mod.F_PHASE
    )

    return (
        f,
        rho,
    )


def correlation_curve(
    solution,
    *,
    box_half: float,
    requested_dx: float,
    profile_rmax: float,
    displacement_max: float,
) -> tuple[
    np.ndarray,
    np.ndarray,
    float,
    int,
]:
    """Compute the axisymmetric core-deficit cross-correlation by FFT."""

    n = odd_grid_count(
        box_half,
        requested_dx,
    )

    x = np.linspace(
        -box_half,
        box_half,
        n,
    )

    dx = float(
        x[1]
        -
        x[0]
    )

    X, Y = np.meshgrid(
        x,
        x,
        indexing="ij",
    )

    radius = np.sqrt(
        X * X
        +
        Y * Y
    )

    f, rho = (
        extract_radial_fields(
            solution,
            radius,
            profile_rmax,
        )
    )

    f_deficit = (
        f * f
        -
        core_mod.ETA_PHI
        *
        core_mod.ETA_PHI
    )

    rho_deficit = (
        rho * rho
        -
        core_mod.F_PHASE
        *
        core_mod.F_PHASE
    )

    correlation = (
        fftconvolve(
            f_deficit,
            rho_deficit,
            mode="same",
        )
        *
        dx
        *
        dx
    )

    center = (
        n // 2
    )

    displacement = (
        x[
            center:
        ]
        -
        x[
            center
        ]
    )

    line = correlation[
        center:,
        center,
    ]

    keep = (
        displacement
        <=
        displacement_max
    )

    return (
        displacement[
            keep
        ],
        line[
            keep
        ],
        dx,
        n,
    )


def interaction_energy_curve(
    displacement: np.ndarray,
    correlation: np.ndarray,
    *,
    kappa_fraction: float,
) -> np.ndarray:
    """Convert one correlation curve into the junction interaction energy."""

    kappa = (
        core_mod.kappa_from_fraction(
            kappa_fraction
        )
    )

    energy = (
        -0.25
        *
        kappa
        *
        correlation
    )

    # Only a constant shift is removed.
    #
    # Forces and barriers are unchanged.
    tail_reference = float(
        energy[-1]
    )

    return (
        energy
        -
        tail_reference
    )


def linear_root(
    x0: float,
    x1: float,
    y0: float,
    y1: float,
) -> float:
    """Linearly interpolate a zero crossing."""

    if y1 == y0:
        return (
            0.5
            *
            (
                x0
                +
                x1
            )
        )

    return (
        x0
        -
        y0
        *
        (
            x1
            -
            x0
        )
        /
        (
            y1
            -
            y0
        )
    )


def force_metrics(
    displacement: np.ndarray,
    interaction_energy: np.ndarray,
    *,
    relaxation_efficiency: float,
    sigma_wall: float,
    delta_wall: float,
) -> ForceMetrics:
    """Find force margin, metastable equilibrium, and escape barrier."""

    eta = float(
        np.clip(
            relaxation_efficiency,
            0.0,
            1.0,
        )
    )

    spline = CubicSpline(
        displacement,
        interaction_energy,
        bc_type="natural",
    )

    dense_d = np.linspace(
        float(
            displacement[0]
        ),
        float(
            displacement[-1]
        ),
        12001,
    )

    raw_force = spline(
        dense_d,
        1,
    )

    force = (
        eta
        *
        raw_force
    )

    max_index = int(
        np.argmax(
            force
        )
    )

    force_max = float(
        force[
            max_index
        ]
    )

    force_max_at_d = float(
        dense_d[
            max_index
        ]
    )

    force_ratio = (
        force_max
        /
        sigma_wall
    )

    balance = (
        force
        -
        sigma_wall
    )

    upward = np.where(
        (
            balance[:-1]
            <
            0.0
        )
        &
        (
            balance[1:]
            >=
            0.0
        )
    )[0]

    stable_found = (
        len(
            upward
        )
        >
        0
    )

    stable_d = math.nan
    unstable_d = math.nan

    stable_curvature = math.nan
    unstable_curvature = math.nan

    barrier = math.nan
    barrier_normalized = math.nan

    unstable_found = False

    if stable_found:
        i_stable = int(
            upward[0]
        )

        stable_d = linear_root(
            dense_d[i_stable],
            dense_d[i_stable + 1],
            balance[i_stable],
            balance[i_stable + 1],
        )

        downward = np.where(
            (
                np.arange(
                    len(
                        balance
                    )
                    -
                    1
                )
                >
                i_stable
            )
            &
            (
                balance[:-1]
                >=
                0.0
            )
            &
            (
                balance[1:]
                <
                0.0
            )
        )[0]

        unstable_found = (
            len(
                downward
            )
            >
            0
        )

        stable_curvature = float(
            eta
            *
            spline(
                stable_d,
                2,
            )
        )

        if unstable_found:
            i_unstable = int(
                downward[0]
            )

            unstable_d = (
                linear_root(
                    dense_d[
                        i_unstable
                    ],
                    dense_d[
                        i_unstable
                        +
                        1
                    ],
                    balance[
                        i_unstable
                    ],
                    balance[
                        i_unstable
                        +
                        1
                    ],
                )
            )

            unstable_curvature = float(
                eta
                *
                spline(
                    unstable_d,
                    2,
                )
            )

            def effective_energy(
                d: float,
            ) -> float:
                return float(
                    eta
                    *
                    (
                        spline(d)
                        -
                        spline(0.0)
                    )
                    -
                    sigma_wall
                    *
                    d
                )

            e_stable = (
                effective_energy(
                    stable_d
                )
            )

            e_unstable = (
                effective_energy(
                    unstable_d
                )
            )

            barrier = (
                e_unstable
                -
                e_stable
            )

            barrier_normalized = (
                barrier
                /
                (
                    sigma_wall
                    *
                    delta_wall
                )
            )

    pass_force_margin = (
        force_ratio
        >=
        FORCE_MARGIN_REQUIRED
    )

    pass_metastable = (
        stable_found
        and
        unstable_found
        and
        np.isfinite(
            barrier
        )
        and
        barrier
        >
        0.0
        and
        stable_curvature
        >
        0.0
        and
        unstable_curvature
        <
        0.0
    )

    passed = (
        pass_force_margin
        and
        pass_metastable
    )

    return ForceMetrics(
        force_ratio=force_ratio,
        force_max=force_max,
        force_max_at_d=force_max_at_d,
        stable_found=stable_found,
        unstable_found=unstable_found,
        stable_d=stable_d,
        unstable_d=unstable_d,
        stable_curvature=stable_curvature,
        unstable_curvature=unstable_curvature,
        barrier=barrier,
        barrier_over_sigma_delta_wall=(
            barrier_normalized
        ),
        pass_force_margin=(
            pass_force_margin
        ),
        pass_metastable=(
            pass_metastable
        ),
        passed=passed,
    )


