        displacement_max=DISPLACEMENT_MAX,
    )

    print(
        f"FFT_MAIN_N={n_base}"
    )

    print(
        f"FFT_MAIN_DX={dx_base:.15e}"
    )

    print(
        f"FFT_MAIN_BOX_HALF={FFT_BOX_MAIN:.9f}"
    )

    print(
        f"FFT_MAIN_DMAX={float(d_base[-1]):.9f}"
    )

    print(
        "\n=== HEALTHY COUPLING FORCE / BARRIER SCAN ==="
    )

    previous = (
        base_solution
    )

    records = {}

    eta_values = []

    for fraction in ALL_MAIN_FRACTIONS:
        solution, diag = (
            core_mod.solve_and_diagnose(
                chi=core_mod.CHI_SELECTED,
                fraction=fraction,
                rmax=PROFILE_RMAX_MAIN,
                previous=previous,
            )
        )

        previous = (
            solution
        )

        delta_total = (
            diag.a_total_ir
            -
            base_diag.a_total_ir
        )

        if (
            diag.a_cross
            >=
            0.0
            or
            delta_total
            >=
            0.0
        ):
            eta = 0.0
        else:
            eta = (
                abs(
                    delta_total
                )
                /
                abs(
                    diag.a_cross
                )
            )

        eta = float(
            np.clip(
                eta,
                0.0,
                1.0,
            )
        )

        eta_values.append(
            eta
        )

        print(
            "COUPLING "
            f"KF={fraction:.9f} "
            f"DELTA_TOTAL={delta_total:+.15e} "
            f"A_CROSS={diag.a_cross:+.15e} "
            f"ETA_RELAX={eta:.12f}"
        )

        base_energy = (
            interaction_energy_curve(
                d_base,
                corr_base,
                kappa_fraction=fraction,
            )
        )

        base_metrics = (
            force_metrics(
                d_base,
                base_energy,
                relaxation_efficiency=eta,
                sigma_wall=sigma_wall,
                delta_wall=delta_wall,
            )
        )

        (
            d_relaxed,
            corr_relaxed,
            dx_relaxed,
            n_relaxed,
        ) = correlation_curve(
            solution,
            box_half=FFT_BOX_MAIN,
            requested_dx=FFT_DX_MAIN,
            profile_rmax=PROFILE_RMAX_MAIN,
            displacement_max=DISPLACEMENT_MAX,
        )

        relaxed_energy = (
            interaction_energy_curve(
                d_relaxed,
                corr_relaxed,
                kappa_fraction=fraction,
            )
        )

        relaxed_metrics = (
            force_metrics(
                d_relaxed,
                relaxed_energy,
                relaxation_efficiency=eta,
                sigma_wall=sigma_wall,
                delta_wall=delta_wall,
            )
        )

        print_metrics(
            f"BASELINE_SHAPE KF={fraction:.9f}",
            base_metrics,
        )

        print_metrics(
            f"RELAXED_SHAPE KF={fraction:.9f}",
            relaxed_metrics,
        )

        both_pass = (
            base_metrics.passed
            and
            relaxed_metrics.passed
        )

        print(
            "FORCE_GATE "
            f"KF={fraction:.9f} "
            f"BOTH_ESTIMATES_PASS="
            f"{'YES' if both_pass else 'NO'}"
        )

        records[
            float(
                fraction
            )
        ] = {
            "solution": solution,
            "diag": diag,
            "eta": eta,
            "base_metrics": (
                base_metrics
            ),
            "relaxed_metrics": (
                relaxed_metrics
            ),
            "both_pass": (
                both_pass
            ),
        }

    print(
        "\n=== NONMARGINAL NEIGHBORHOOD DECISION ==="
    )

    nonmarginal_passes = [
        fraction
        for fraction
        in NONMARGINAL_HEALTHY
        if bool(
            records[
                float(
                    fraction
                )
            ][
                "both_pass"
            ]
        )
    ]

    print(
        "NONMARGINAL_TESTED_COUNT="
        f"{len(NONMARGINAL_HEALTHY)}"
    )

    print(
        "NONMARGINAL_PASS_COUNT="
        f"{len(nonmarginal_passes)}"
    )

    if nonmarginal_passes:
        print(
            "NONMARGINAL_PASS_MIN_KF="
            f"{min(nonmarginal_passes):.9f}"
        )

        print(
            "NONMARGINAL_PASS_MAX_KF="
            f"{max(nonmarginal_passes):.9f}"
        )

    nonmarginal_all_pass = (
        len(
            nonmarginal_passes
        )
        ==
        len(
            NONMARGINAL_HEALTHY
        )
    )

    print(
        "NONMARGINAL_CONTIGUOUS_FORCE_BASIN="
        f"{'PASS' if nonmarginal_all_pass else 'FAIL'}"
    )

    print(
        "\n=== SELECTED 0.625 FFT CONVERGENCE ==="
    )

    selected = (
        records[
            0.625
        ]
    )

    selected_solution = (
        selected[
            "solution"
        ]
    )

    selected_eta = float(
        selected[
            "eta"
        ]
    )

    grid_force_ratios = []

    for (
        box_half,
        requested_dx,
    ) in GRID_CONVERGENCE_CASES:

        (
            d_conv,
            corr_conv,
            dx_conv,
            n_conv,
        ) = correlation_curve(
            selected_solution,
            box_half=box_half,
            requested_dx=requested_dx,
            profile_rmax=PROFILE_RMAX_MAIN,
            displacement_max=min(
                DISPLACEMENT_MAX,
                0.75
                *
                box_half,
            ),
        )

        e_conv = (
            interaction_energy_curve(
                d_conv,
                corr_conv,
                kappa_fraction=0.625,
            )
        )

        m_conv = (
            force_metrics(
                d_conv,
                e_conv,
                relaxation_efficiency=selected_eta,
                sigma_wall=sigma_wall,
                delta_wall=delta_wall,
            )
        )

        grid_force_ratios.append(
            m_conv.force_ratio
        )

        print(
            "GRID_CONV "
            f"BOX_HALF={box_half:.6f} "
            f"N={n_conv} "
            f"DX={dx_conv:.12e} "
            f"FORCE_RATIO={m_conv.force_ratio:.12f} "
            f"STABLE_D={m_conv.stable_d:.9f} "
            f"UNSTABLE_D={m_conv.unstable_d:.9f} "
            f"BARRIER={m_conv.barrier:.15e} "
            f"PASS={'YES' if m_conv.passed else 'NO'}"
        )

    grid_force_ratios = np.array(
        grid_force_ratios,
        dtype=float,
    )

    grid_spread = (
        float(
            np.max(
                grid_force_ratios
            )
            -
            np.min(
                grid_force_ratios
            )
        )
        /
        float(
            np.mean(
                grid_force_ratios
            )
        )
    )

    print(
        f"GRID_FORCE_RATIO_REL_SPREAD={grid_spread:.15e}"
    )

    grid_convergence_pass = (
        grid_spread
        <=
        MAX_GRID_FORCE_RATIO_SPREAD
    )

    print(
        "FFT_GRID_CONVERGENCE="
        f"{'PASS' if grid_convergence_pass else 'FAIL'}"
    )

    print(
        "\n=== SELECTED 0.625 RADIAL-PROFILE DOMAIN CONVERGENCE ==="
    )

    profile_force_ratios = []

    for rmax in PROFILE_RMAX_CONVERGENCE:
        base_sol_r, base_diag_r = (
            core_mod.solve_and_diagnose(
                chi=core_mod.CHI_SELECTED,
                fraction=0.0,
                rmax=rmax,
            )
        )

        selected_sol_r, selected_diag_r = (
            core_mod.solve_and_diagnose(
                chi=core_mod.CHI_SELECTED,
                fraction=0.625,
                rmax=rmax,
                previous=base_sol_r,
            )
        )

        delta_r = (
            selected_diag_r.a_total_ir
            -
            base_diag_r.a_total_ir
        )

        eta_r = (
            abs(
                delta_r
            )
            /
            abs(
                selected_diag_r.a_cross
            )
        )

        eta_r = float(
            np.clip(
                eta_r,
                0.0,
                1.0,
            )
        )

        d_r, corr_r, _, _ = (
            correlation_curve(
                selected_sol_r,
                box_half=FFT_BOX_MAIN,
                requested_dx=FFT_DX_MAIN,
                profile_rmax=rmax,
                displacement_max=DISPLACEMENT_MAX,
            )
        )

        e_r = (
            interaction_energy_curve(
                d_r,
                corr_r,
                kappa_fraction=0.625,
            )
        )

        metrics_r = (
            force_metrics(
                d_r,
                e_r,
                relaxation_efficiency=eta_r,
                sigma_wall=sigma_wall,
                delta_wall=delta_wall,
            )
        )

        profile_force_ratios.append(
            metrics_r.force_ratio
        )

        print(
            "PROFILE_CONV "
            f"RMAX={rmax:.3f} "
            f"ETA={eta_r:.12f} "
            f"FORCE_RATIO={metrics_r.force_ratio:.12f} "
            f"STABLE_D={metrics_r.stable_d:.9f} "
            f"UNSTABLE_D={metrics_r.unstable_d:.9f} "
            f"BARRIER={metrics_r.barrier:.15e} "
            f"PASS={'YES' if metrics_r.passed else 'NO'}"
        )

    profile_force_ratios = (
        np.array(
            profile_force_ratios,
            dtype=float,
        )
    )

    profile_spread = (
        float(
            np.max(
                profile_force_ratios
            )
            -
            np.min(
                profile_force_ratios
            )
        )
        /
        float(
            np.mean(
                profile_force_ratios
            )
        )
    )

    print(
        f"PROFILE_FORCE_RATIO_REL_SPREAD={profile_spread:.15e}"
    )

    profile_convergence_pass = (
        profile_spread
        <=
        MAX_PROFILE_FORCE_RATIO_SPREAD
    )

    print(
        "RADIAL_PROFILE_CONVERGENCE="
        f"{'PASS' if profile_convergence_pass else 'FAIL'}"
    )

    print(
        "\n=== CONSERVATIVE CRITICAL COUPLING ESTIMATE ==="
    )

    eta_floor = float(
        min(
            records[
                float(
                    fraction
                )
            ][
                "eta"
            ]
            for fraction
            in NONMARGINAL_HEALTHY
        )
    )

    unit_energy = (
        interaction_energy_curve(
            d_base,
            corr_base,
            kappa_fraction=0.999,
        )
    )

    unit_metrics = (
        force_metrics(
            d_base,
            unit_energy,
            relaxation_efficiency=eta_floor,
            sigma_wall=sigma_wall,
            delta_wall=delta_wall,
        )
    )

    if (
        unit_metrics.force_ratio
        >
        0.0
    ):
        critical_fraction_linear = (
            0.999
            /
            unit_metrics.force_ratio
        )
    else:
        critical_fraction_linear = (
            math.inf
        )

    print(
        f"ETA_RELAX_FLOOR={eta_floor:.15e}"
    )

    print(
        f"LINEARIZED_CRITICAL_KF_ESTIMATE="
        f"{critical_fraction_linear:.15e}"
    )

    print(
        "\n=== BLIND WILDCARD FORCE CHECK ==="
    )

    for raw in WILDCARD_VALUES:
        if raw > 1.0:
            fraction = (
                1.0
                /
                raw
            )

            transform = (
                "INVERSE"
            )
        else:
            fraction = raw

            transform = (
                "IDENTITY"
            )

        if not (
            0.0
            <=
            fraction
            <
            1.0
        ):
            print(
                "WILDCARD "
                f"RAW={raw:.9f} "
                "VALID=NO"
            )
            continue

        wildcard_energy = (
            interaction_energy_curve(
                d_base,
                corr_base,
                kappa_fraction=fraction,
            )
        )

        wildcard_metrics = (
            force_metrics(
                d_base,
                wildcard_energy,
                relaxation_efficiency=eta_floor,
                sigma_wall=sigma_wall,
                delta_wall=delta_wall,
            )
        )

        print(
            "WILDCARD "
            f"RAW={raw:.9f} "
            f"TRANSFORM={transform} "
            f"KF={fraction:.9f} "
            f"FORCE_RATIO={wildcard_metrics.force_ratio:.12f} "
            f"STABLE_D={wildcard_metrics.stable_d:.9f} "
            f"BARRIER={wildcard_metrics.barrier:.15e} "
            f"PASS={'YES' if wildcard_metrics.passed else 'NO'} "
            "INTERPRETATION=BLIND_CONTROL_ONLY"
        )

    print(
        "\n=== 018A-3 DECISION ==="
    )

    selected_both_pass = bool(
        records[
            0.625
        ][
            "both_pass"
        ]
    )

    overall_green = (
        nonmarginal_all_pass
        and
        selected_both_pass
        and
        grid_convergence_pass
        and
        profile_convergence_pass
    )

    print(
        "SELECTED_KF_0P625_FORCE_GATE="
        f"{'PASS' if selected_both_pass else 'FAIL'}"
    )

    print(
        "NONMARGINAL_FORCE_BASIN="
        f"{'PASS' if nonmarginal_all_pass else 'FAIL'}"
    )

    print(
        "FFT_GRID_CONVERGENCE="
        f"{'PASS' if grid_convergence_pass else 'FAIL'}"
    )

    print(
        "RADIAL_PROFILE_CONVERGENCE="
        f"{'PASS' if profile_convergence_pass else 'FAIL'}"
    )

    print(
        "018A3_WALL_PULL_VS_BINDING_FORCE_GATE="
        f"{'GREEN' if overall_green else 'RED'}"
    )

    print(
        "TRUE_2D_STRING_WALL_JUNCTION="
        "NOT_YET_SOLVED"
    )

    print(
        "COMPLETE_JUNCTION_STRESS_ENERGY="
        "NOT_YET_SOLVED"
    )

    print(
        "FINITE_PAYLOAD_GRAVITY_AFTER_TRUE_JUNCTION="
        "NOT_YET_TESTED"
    )

    print(
        "FULL_018A_GATE="
        "NOT_YET_GREEN"
    )

    print(
        "PRACTICAL_ANTIGRAVITY_DEVICE="
        "NO"
    )

    print(
        "CLAIM_CLASSIFICATION="
        "PROJECT_DERIVED_018A_TRANSLATIONAL_JUNCTION_FORCE_PREFLIGHT"
    )

    if overall_green:
        print(
            "NEXT="
            "018A4_TRUE_2D_EXPLICIT_BREAKING_STRING_WALL_JUNCTION_WITH_ANISOTROPIC_FIELD_RELAXATION"
        )
    else:
