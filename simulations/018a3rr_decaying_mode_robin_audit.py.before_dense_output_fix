@dataclass
class RobinMode:
    """Numerical logarithmic derivative of the physical decaying Jacobi mode."""

    solution: object
    r_min: float
    r_far: float


def radial_mass_sq() -> float:
    """Return the vacuum radial-mode mass squared."""

    return (
        2.0
        *
        core.LAMBDA_A
        *
        core.F_PHASE
        *
        core.F_PHASE
    )


def radial_mass() -> float:
    """Return the vacuum radial-mode mass."""

    return math.sqrt(
        radial_mass_sq()
    )


def rho_reference_values(
    reference,
    radius: np.ndarray | float,
) -> tuple[
    np.ndarray,
    np.ndarray,
]:
    """Evaluate isolated global-string rho and rho'."""

    arr = np.asarray(
        radius,
        dtype=float,
    )

    clipped = np.clip(
        arr,
        core.R0,
        reference.rmax,
    )

    values = reference.solution.sol(
        clipped
    )

    rho = np.asarray(
        values[0],
        dtype=float,
    )

    rho_p = np.asarray(
        values[1],
        dtype=float,
    )

    return (
        rho,
        rho_p,
    )


def jacobi_q(
    reference,
    radius: np.ndarray | float,
) -> np.ndarray:
    """Return q(r) in the linearized outer amplitude equation."""

    arr = np.asarray(
        radius,
        dtype=float,
    )

    rho0, _ = (
        rho_reference_values(
            reference,
            arr,
        )
    )

    return (
        1.0
        /
        (
            arr
            *
            arr
        )
        +
        core.LAMBDA_A
        *
        (
            3.0
            *
            rho0
            *
            rho0
            -
            core.F_PHASE
            *
            core.F_PHASE
        )
    )


def solve_robin_mode(
    reference,
) -> RobinMode:
    """Integrate the decaying-mode logarithmic derivative inward."""

    m = radial_mass()

    z_far = (
        m
        *
        RICCATI_R_FAR
    )

    asymptotic_g = (
        -m
        *
        k0(
            z_far
        )
        /
        k1(
            z_far
        )
        -
        1.0
        /
        RICCATI_R_FAR
    )

    def rhs(
        radius: float,
        y: np.ndarray,
    ) -> np.ndarray:
        g = float(
            y[0]
        )

        q = float(
            jacobi_q(
                reference,
                radius,
            )
        )

        return np.array(
            [
                q
                -
                g
                *
                g
                -
                g
                /
                radius
            ]
        )

    solution = solve_ivp(
        rhs,
        (
            RICCATI_R_FAR,
            RICCATI_R_MIN,
        ),
        np.array(
            [
                asymptotic_g
            ]
        ),
        dense_output=True,
        rtol=2.0e-11,
        atol=2.0e-13,
        max_step=0.25,
    )

    if not solution.success:
        raise RuntimeError(
            "Riccati integration failed: "
            f"{solution.message}"
        )

    return RobinMode(
        solution=solution,
        r_min=RICCATI_R_MIN,
        r_far=RICCATI_R_FAR,
    )


def robin_g(
    mode: RobinMode,
    radius: float | np.ndarray,
) -> np.ndarray:
    """Evaluate the decaying-mode logarithmic derivative."""

    arr = np.asarray(
        radius,
        dtype=float,
    )

    if (
        np.min(
            arr
        )
        <
        mode.r_min
        or
        np.max(
            arr
        )
        >
        mode.r_far
    ):
        raise ValueError(
            "Requested Robin radius outside integrated interval"
        )

    return np.asarray(
        mode.solution.sol(
            arr
        )[0],
        dtype=float,
    )


def solve_robin_composite(
    *,
    chi: float,
    fraction: float,
    rmax: float,
    reference,
    robin_mode: RobinMode,
    previous=None,
):
    """Solve the coupled radial composite with the physical decaying-mode BC."""

    if not (
        0.0
        <=
        fraction
        <
        1.0
    ):
        raise ValueError(
            "fraction must satisfy 0 <= fraction < 1"
        )

    kappa = (
        core.kappa_from_fraction(
            fraction
        )
    )

    rho0_outer, rho0p_outer = (
        rho_reference_values(
            reference,
            rmax,
        )
    )

    rho0_outer = float(
        rho0_outer
    )

    rho0p_outer = float(
        rho0p_outer
    )

    g_outer = float(
        robin_g(
            robin_mode,
            rmax,
        )
    )

    r = np.geomspace(
        core.R0,
        rmax,
        core.BASE_GRID_POINTS,
    )

    if previous is None:
        guess = core.initial_guess(
            r
        )

        rho0_guess, rho0p_guess = (
            rho_reference_values(
                reference,
                r,
            )
        )

        guess[
            6
        ] = rho0_guess

        guess[
            7
        ] = rho0p_guess
    else:
        previous_rmax = float(
            previous.x[-1]
        )

        clipped = np.clip(
            r,
            core.R0,
            previous_rmax,
        )

        guess = previous.sol(
            clipped
        )

        beyond = (
            r
            >
            previous_rmax
        )

        if np.any(
            beyond
        ):
            rho0_guess, rho0p_guess = (
                rho_reference_values(
                    reference,
                    r[
                        beyond
                    ],
                )
            )

            guess[
                0,
                beyond,
            ] = core.ETA_PHI

            guess[
                1,
                beyond,
            ] = 0.0

            guess[
                2,
                beyond,
            ] = 0.0

            guess[
                3,
                beyond,
            ] = 0.0

            guess[
                4,
                beyond,
            ] = (
                core.VORTEX_WINDING
                /
                core.GAUGE_G
            )

            guess[
                5,
                beyond,
            ] = 0.0

            guess[
                6,
                beyond,
            ] = rho0_guess

            guess[
                7,
                beyond,
            ] = rho0p_guess

    def ode(
        rr: np.ndarray,
        y: np.ndarray,
    ) -> np.ndarray:
        (
            f,
            fp,
            s,
            sp,
            gauge,
            gauge_p,
            rho,
            rho_p,
        ) = y

        rr_safe = np.maximum(
            rr,
            1.0e-12,
        )

        angular = (
            (
                core.VORTEX_WINDING
                -
                core.GAUGE_G
                *
                gauge
            )
            /
            rr_safe
        ) ** 2

        f_pp = (
            -fp
            /
            rr_safe
            +
            (
                0.5
                *
                core.LAMBDA_PHI
                *
                (
                    f
                    *
                    f
                    -
                    core.ETA_PHI
                    *
                    core.ETA_PHI
                )
                +
                core.BETA
                *
                s
                *
                s
                +
                angular
                -
                0.25
                *
                kappa
                *
                (
                    rho
                    *
                    rho
                    -
                    core.F_PHASE
                    *
                    core.F_PHASE
                )
            )
            *
            f
        )

        s_pp = (
            -sp
            /
            rr_safe
            +
            (
                0.5
                *
                core.LAMBDA_SIGMA
                *
                (
                    s
                    *
                    s
                    -
                    core.ETA_SIGMA
                    *
                    core.ETA_SIGMA
                )
                +
                core.BETA
                *
                f
                *
                f
                -
                chi
            )
            *
            s
        )

        gauge_pp = (
            gauge_p
            /
            rr_safe
            -
            2.0
            *
            core.GAUGE_G
            *
            f
            *
            f
            *
            (
                core.VORTEX_WINDING
                -
                core.GAUGE_G
                *
                gauge
            )
        )

        rho_pp = (
            -rho_p
            /
            rr_safe
            +
            rho
            /
            (
                rr_safe
                *
                rr_safe
            )
            +
            (
                core.LAMBDA_A
                *
                (
                    rho
                    *
                    rho
                    -
                    core.F_PHASE
                    *
                    core.F_PHASE
                )
                -
                0.5
                *
                kappa
                *
                (
                    f
                    *
                    f
                    -
                    core.ETA_PHI
                    *
                    core.ETA_PHI
                )
            )
            *
            rho
        )

        return np.vstack(
            [
                fp,
                f_pp,
                sp,
                s_pp,
                gauge_p,
                gauge_pp,
                rho_p,
                rho_pp,
            ]
        )

    def bc(
        ya: np.ndarray,
        yb: np.ndarray,
    ) -> np.ndarray:
        delta_outer = (
            yb[6]
            -
            rho0_outer
        )

        robin_residual = (
            yb[7]
            -
            rho0p_outer
            -
            g_outer
            *
            delta_outer
        )

        return np.array(
            [
                ya[0],
                ya[3],
                ya[4],
                ya[6],

                yb[0]
                -
                core.ETA_PHI,

                yb[2],

                yb[4]
                -
                core.VORTEX_WINDING
                /
                core.GAUGE_G,

                robin_residual,
            ]
        )

    solution = solve_bvp(
        ode,
        bc,
        r,
        guess,
        tol=COMPOSITE_BVP_TOL,
        max_nodes=COMPOSITE_MAX_NODES,
    )

    if solution.status != 0:
        raise RuntimeError(
            "Robin composite BVP failed: "
            f"{solution.message}"
        )

    return solution


def propagate_response(
    *,
    solution,
    rmax: float,
    reference,
    robin_mode: RobinMode,
    r_end: float,
):
    """Propagate the physical decaying amplitude response beyond the BVP."""

    rho0_r, rho0p_r = (
        rho_reference_values(
            reference,
            rmax,
        )
    )

    rho0_r = float(
        rho0_r
    )

    rho0p_r = float(
        rho0p_r
    )

    composite_edge = (
        solution.sol(
            rmax
        )
    )

    delta_r = (
        float(
            composite_edge[
                6
            ]
        )
        -
        rho0_r
    )

    delta_p_r = (
        float(
            composite_edge[
                7
            ]
        )
        -
        rho0p_r
    )

    g_expected = float(
        robin_g(
            robin_mode,
            rmax,
        )
    )

    if (
        abs(
            delta_r
        )
        >
        1.0e-14
    ):
        robin_ratio_error = (
            abs(
                delta_p_r
                /
                delta_r
                -
                g_expected
            )
        )
    else:
        robin_ratio_error = (
            abs(
                delta_p_r
                -
                g_expected
                *
                delta_r
            )
        )

    def rhs(
        radius: float,
        y: np.ndarray,
    ) -> np.ndarray:
        delta = float(
            y[0]
        )

        delta_p = float(
            y[1]
        )

        q = float(
            jacobi_q(
                reference,
                radius,
            )
        )

        delta_pp = (
            -delta_p
            /
            radius
            +
            q
            *
            delta
        )

        return np.array(
            [
                delta_p,
                delta_pp,
            ]
        )

    response = solve_ivp(
        rhs,
        (
            rmax,
            r_end,
        ),
        np.array(
            [
                delta_r,
                delta_p_r,
            ]
        ),
        dense_output=True,
        rtol=2.0e-10,
        atol=2.0e-13,
        max_step=0.20,
    )

    if not response.success:
        raise RuntimeError(
            "Outer response propagation failed: "
            f"{response.message}"
        )

    return (
        response,
        robin_ratio_error,
    )


def response_tail_energy(
    *,
    response,
    rmax: float,
    r_end: float,
    reference,
) -> float:
    """Integrate differential global-string amplitude energy outside R_max."""

    r = np.linspace(
        rmax,
        r_end,
        5000,
    )

    rho0, rho0p = (
        rho_reference_values(
            reference,
            r,
        )
    )

    response_values = (
        response.sol(
            r
        )
    )

    delta = (
        response_values[
            0
        ]
    )

    delta_p = (
        response_values[
            1
        ]
    )

    rho1 = (
        rho0
        +
        delta
    )

    rho1p = (
        rho0p
        +
        delta_p
    )

    e0 = (
        0.5
        *
        rho0p
        *
        rho0p
        +
        0.5
        *
        rho0
        *
        rho0
        /
        (
            r
            *
            r
        )
        +
        0.25
        *
        core.LAMBDA_A
        *
        (
            rho0
            *
            rho0
            -
            core.F_PHASE
            *
            core.F_PHASE
        ) ** 2
    )

    e1 = (
        0.5
        *
        rho1p
        *
        rho1p
        +
        0.5
        *
        rho1
        *
        rho1
        /
        (
            r
            *
            r
        )
        +
        0.25
        *
        core.LAMBDA_A
        *
        (
            rho1
            *
            rho1
            -
            core.F_PHASE
            *
            core.F_PHASE
        ) ** 2
    )

    return float(
        2.0
        *
        math.pi
        *
        simpson(
            r
            *
            (
                e1
                -
                e0
            ),
            x=r,
        )
    )


def smooth_taper_weight(
    radius: np.ndarray,
) -> np.ndarray:
    """Smoothly suppress isotropic global-string structure near 1/m_A."""

    r_ir = (
        1.0
        /
        core.M_A
    )

    start = (
        IR_TAPER_START_FRACTION
        *
        r_ir
    )

    weight = np.ones_like(
        radius,
        dtype=float,
    )

    outside = (
        radius
        >=
        r_ir
    )

    transition = (
        (
            radius
            >
            start
        )
        &
        (
            radius
            <
            r_ir
        )
    )

    weight[
        outside
    ] = 0.0

    u = (
        radius[
            transition
        ]
        -
        start
    ) / (
        r_ir
        -
        start
    )

    weight[
        transition
    ] = (
        0.5
        *
        (
            1.0
            +
            np.cos(
                math.pi
                *
                u
            )
        )
    )

    return weight


def odd_grid_count(
    box_half: float,
    requested_dx: float,
) -> int:
    """Return an odd Cartesian FFT grid size."""

    n = int(
        round(
            2.0
            *
            box_half
            /
            requested_dx
        )
    ) + 1

    if n % 2 == 0:
        n += 1

    return max(
        n,
        101,
    )


def robin_correlation(
    *,
    solution,
    rmax: float,
    reference,
    response,
) -> tuple[
    np.ndarray,
    np.ndarray,
    float,
    int,
]:
    """Construct the relaxed displaced interaction with the propagated tail."""

    n = odd_grid_count(
        FFT_BOX_HALF,
        FFT_REQUESTED_DX,
    )

    x = np.linspace(
        -FFT_BOX_HALF,
        FFT_BOX_HALF,
        n,
    )

    dx = float(
        x[1]
        -
        x[0]
    )

    X, Y = np.meshgrid(
        x,
        x,
        indexing="ij",
    )

    radius = np.sqrt(
        X
        *
        X
        +
        Y
        *
        Y
    )

    flat = radius.ravel()

    clipped = np.clip(
        flat,
        core.R0,
        rmax,
    )

    inside_values = (
        solution.sol(
            clipped
        )
    )

    f = (
        inside_values[
            0
        ]
        .reshape(
            radius.shape
        )
    )

    rho = (
        inside_values[
            6
        ]
        .reshape(
            radius.shape
        )
    )

    f = np.array(
        f,
        copy=True,
    )

    rho = np.array(
        rho,
        copy=True,
    )

    inside = (
        radius
        <=
        rmax
    )

    f[
        ~inside
    ] = core.ETA_PHI

    r_ir = (
        1.0
        /
        core.M_A
    )

    outside_r = np.clip(
        radius,
        rmax,
        r_ir,
    )

    rho0_out, _ = (
        rho_reference_values(
            reference,
            outside_r,
        )
    )

    response_values = (
        response.sol(
            outside_r
        )
    )

    delta_out = (
        response_values[
            0
        ]
    )

    rho_out = (
        rho0_out
        +
        delta_out
    )

    taper = (
        smooth_taper_weight(
            radius
        )
    )

    rho_out_tapered = (
        core.F_PHASE
        +
        taper
        *
        (
            rho_out
            -
            core.F_PHASE
        )
    )

    rho[
        ~inside
    ] = (
        rho_out_tapered[
            ~inside
        ]
    )

    axis = (
        radius
        <
        core.R0
    )

    f[
        axis
    ] = 0.0

    rho[
        axis
    ] = 0.0

    f_deficit = (
        f
        *
        f
        -
        core.ETA_PHI
        *
        core.ETA_PHI
    )

    rho_deficit = (
        rho
        *
        rho
        -
        core.F_PHASE
        *
        core.F_PHASE
    )

    correlation = (
        fftconvolve(
            f_deficit,
            rho_deficit,
            mode="same",
        )
        *
        dx
        *
        dx
    )

    center = (
        n
        //
        2
    )

    displacement = (
        x[
            center:
        ]
        -
        x[
            center
        ]
    )

    line = correlation[
        center:,
        center,
    ]

    keep = (
        displacement
        <=
        DISPLACEMENT_MAX
    )

    return (
        displacement[
            keep
        ],
        line[
            keep
        ],
        dx,
        n,
    )


def interaction_energy(
    correlation: np.ndarray,
    fraction: float,
) -> np.ndarray:
    """Convert overlap correlation to junction interaction energy."""

    kappa = (
        core.kappa_from_fraction(
            fraction
        )
    )

    energy = (
        -0.25
        *
        kappa
        *
        correlation
    )

    return (
        energy
        -
        float(
            energy[-1]
        )
    )


def solve_pair(
    *,
    fraction: float,
    rmax: float,
    reference,
    robin_mode,
    previous_base=None,
    previous_selected=None,
):
    """Solve separated and interacting Robin composites and diagnostics."""

    base_solution = (
        solve_robin_composite(
            chi=core.CHI_SELECTED,
            fraction=0.0,
            rmax=rmax,
            reference=reference,
            robin_mode=robin_mode,
            previous=previous_base,
        )
    )

    selected_solution = (
        solve_robin_composite(
            chi=core.CHI_SELECTED,
            fraction=fraction,
            rmax=rmax,
            reference=reference,
            robin_mode=robin_mode,
            previous=previous_selected,
        )
    )

    base_diag = (
        core.diagnose(
            base_solution,
            chi=core.CHI_SELECTED,
            kappa_fraction=0.0,
            rmax=rmax,
        )
    )

    selected_diag = (
        core.diagnose(
            selected_solution,
            chi=core.CHI_SELECTED,
            kappa_fraction=fraction,
            rmax=rmax,
        )
    )

    r_ir = (
        1.0
        /
        core.M_A
    )

    response, robin_error = (
        propagate_response(
            solution=selected_solution,
            rmax=rmax,
            reference=reference,
            robin_mode=robin_mode,
            r_end=r_ir,
        )
    )

    delta_tail = (
        response_tail_energy(
            response=response,
            rmax=rmax,
            r_end=r_ir,
            reference=reference,
        )
    )

    delta_total_inner = (
        selected_diag.a_total_ir
        -
        base_diag.a_total_ir
    )

    delta_total_corrected = (
        delta_total_inner
        +
        delta_tail
    )

    eta = (
        abs(
            delta_total_corrected
        )
        /
        abs(
            selected_diag.a_cross
        )
    )

    eta = float(
        np.clip(
            eta,
            0.0,
            1.0,
        )
    )

    (
        displacement,
        correlation,
        dx,
        n,
    ) = (
        robin_correlation(
            solution=selected_solution,
            rmax=rmax,
            reference=reference,
            response=response,
        )
    )

    energy = (
        interaction_energy(
            correlation,
            fraction,
        )
    )

    delta_wall = (
        1.0
        /
        gate3.wall_mod.wall_parameters(
            gate3.wall_mod.F_PHASE,
            gate3.wall_mod.MASS_HIERARCHY,
        )[
            "m_a"
        ]
    )

    wall = (
        gate3.wall_mod.solve_planar_wall(
            gate3.wall_mod.F_PHASE,
            gate3.wall_mod.MASS_HIERARCHY,
            12.0,
        )
    )

    sigma_wall = float(
        wall[
            "tension"
        ]
    )

    metrics = (
        gate3.force_metrics(
            displacement,
            energy,
            relaxation_efficiency=eta,
            sigma_wall=sigma_wall,
            delta_wall=delta_wall,
        )
    )

    return {
        "base_solution": (
            base_solution
        ),
        "selected_solution": (
            selected_solution
        ),
        "base_diag": base_diag,
        "selected_diag": (
            selected_diag
        ),
        "response": response,
        "robin_error": (
            robin_error
        ),
        "delta_tail": (
            delta_tail
        ),
        "delta_total_inner": (
            delta_total_inner
        ),
        "delta_total_corrected": (
            delta_total_corrected
        ),
        "eta": eta,
        "metrics": metrics,
        "fft_dx": dx,
        "fft_n": n,
        "sigma_wall": (
            sigma_wall
        ),
    }


def local_profile_vector(
    solution,
) -> np.ndarray:
    """Sample physical profiles on a common local interval."""

    r = np.linspace(
        core.R0,
        30.0,
        1000,
    )

    values = solution.sol(
        r
    )

    return np.vstack(
        [
            values[0],
            values[2],
            core.GAUGE_G
            *
            values[4],
            values[6]
            /
            core.F_PHASE,
        ]
    )


