            else
            math.nan
        )

        print(
            "MATCHED_RESOLUTION "
            f"N={n} "
            f"DX={full.dx:.12f} "
            f"FULL_DELTA_E={full.relaxation_delta_energy:+.15e} "
            f"BASE_DELTA_E={base.delta_energy:+.15e} "
            f"BASE_OVER_FULL={common_fraction:+.12f} "
