    full_delta = np.array(
        [
            record[
                "full"
            ].relaxation_delta_energy
            for record
            in resolution_records
        ],
        dtype=float,
    )

    corrected_delta = np.array(
        [
            record[
                "corrected_relaxation"
            ]
            for record
            in resolution_records
        ],
        dtype=float,
    )

    mu_matched = np.array(
        [
            record[
                "mu_matched"
            ]
            for record
            in resolution_records
        ],
        dtype=float,
    )

    sigma_matched = np.array(
        [
            record[
                "sigma2_matched"
            ]
            for record
            in resolution_records
        ],
        dtype=float,
    )

    raw_delta_range = float(
        np.max(
