            np.max(
                mu_matched
            )
            -
            np.min(
                mu_matched
            )
        )
        /
        mu_scale
    )

    sigma_spread = (
        float(
            np.max(
                sigma_matched
            )
            -
            np.min(
                sigma_matched
            )
        )
        /
        float(
            np.mean(
                sigma_matched
            )
        )
