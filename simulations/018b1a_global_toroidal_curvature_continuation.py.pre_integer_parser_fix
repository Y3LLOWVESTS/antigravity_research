        *
        int(
            np.count_nonzero(
                problem.az_free
            )
        )
    )

    return result


def action_and_gradient(
    g2,
    p,
    problem: ToroidalProblem,
    vector: np.ndarray,
):
    """Return normalized cylindrical stationary action and exact gradient.

    The complete local action has an overall factor 2*pi*R.  It is divided out
    here.  The remaining geometric weight is r/R.

    That constant normalization leaves every Euler-Lagrange stationary point
    unchanged while keeping optimizer scales comparable to 018B-0G2.
    """

    (
        h,
        phi,
        sigma,
        a,
        ax,
        az,
    ) = unpack(
        problem,
        vector,
    )

    H = (
        h
        *
        problem.phase
    )

    dx = problem.dx

    g_h = np.zeros_like(
        h
    )

    g_phi = np.zeros_like(
        phi
    )

    g_sigma = np.zeros_like(
        sigma
    )

    g_a = np.zeros_like(
        a,
        dtype=complex,
    )

    g_ax = np.zeros_like(
        ax
    )

    g_az = np.zeros_like(
        az
    )

    g_H = np.zeros_like(
        H,
        dtype=complex,
    )

    energy = 0.0

    # Cylindrical r/R weights at nodes, links, and plaquettes.
    node_cyl = (
        problem.cylindrical_r
        /
        problem.R
    )

    r_x_link = (
        0.5
        *
        (
            problem.cylindrical_r[
                1:,
                :
            ]
            +
            problem.cylindrical_r[
                :-1,
                :
            ]
        )
        /
        problem.R
    )

    r_z_link = (
        0.5
        *
        (
            problem.cylindrical_r[
                :,
                1:
            ]
            +
            problem.cylindrical_r[
                :,
                :-1
            ]
        )
        /
        problem.R
    )

    r_cell = (
        0.25
        *
        (
            problem.cylindrical_r[
                :-1,
                :-1
            ]
            +
            problem.cylindrical_r[
                1:,
                :-1
            ]
            +
            problem.cylindrical_r[
                :-1,
                1:
            ]
            +
            problem.cylindrical_r[
                1:,
                1:
            ]
        )
        /
        problem.R
    )

    # ---------------------------------------------------------------
    # Charge-two H covariant transverse gradients.
    # ---------------------------------------------------------------

    u_hx = np.exp(
        -2.0j
        *
        ax
    )

    d_hx = (
        H[
            1:,
            :
        ]
        -
        u_hx
        *
        H[
            :-1,
            :
        ]
    )

    energy += (
        0.5
        *
        float(
            np.sum(
                r_x_link
                *
                np.abs(
                    d_hx
                ) ** 2
            )
        )
    )

    weighted = (
        r_x_link
        *
        d_hx
    )

    g_H[
        1:,
        :
    ] += weighted

    g_H[
        :-1,
        :
    ] -= (
        np.conj(
            u_hx
        )
        *
        weighted
    )

    g_ax += (
        -2.0
        *
        r_x_link
        *
        np.imag(
            np.conj(
                d_hx
            )
            *
            u_hx
            *
            H[
                :-1,
                :
            ]
        )
    )

    u_hz = np.exp(
        -2.0j
        *
        az
    )

    d_hz = (
        H[
            :,
            1:
        ]
        -
        u_hz
        *
        H[
            :,
            :-1
        ]
    )

    energy += (
        0.5
        *
        float(
            np.sum(
                r_z_link
                *
                np.abs(
                    d_hz
                ) ** 2
            )
        )
    )

    weighted = (
        r_z_link
        *
        d_hz
    )

    g_H[
        :,
        1:
    ] += weighted

    g_H[
        :,
        :-1
    ] -= (
        np.conj(
            u_hz
        )
        *
        weighted
    )

    g_az += (
        -2.0
        *
        r_z_link
        *
        np.imag(
            np.conj(
                d_hz
            )
            *
            u_hz
            *
            H[
                :,
                :-1
            ]
        )
    )

    g_h += np.real(
        np.conj(
            problem.phase
        )
        *
        g_H
    )

    # ---------------------------------------------------------------
    # Neutral carrier transverse gradients.
    # ---------------------------------------------------------------

    for field, gradient in (
        (
            phi,
            g_phi,
        ),
        (
            sigma,
            g_sigma,
        ),
    ):

        delta = (
            field[
                1:,
                :
            ]
            -
            field[
                :-1,
                :
            ]
        )

        energy += (
            0.5
            *
            float(
                np.sum(
                    r_x_link
                    *
                    delta
                    *
                    delta
                )
            )
        )

        weighted = (
            r_x_link
            *
            delta
        )

        gradient[
            1:,
            :
        ] += weighted

        gradient[
            :-1,
            :
        ] -= weighted

        delta = (
            field[
                :,
                1:
            ]
            -
            field[
                :,
                :-1
            ]
        )

        energy += (
            0.5
            *
            float(
                np.sum(
                    r_z_link
                    *
                    delta
                    *
                    delta
                )
            )
        )

        weighted = (
            r_z_link
            *
            delta
        )

        gradient[
            :,
            1:
        ] += weighted

        gradient[
            :,
            :-1
        ] -= weighted

    # ---------------------------------------------------------------
    # Charge-one KLS field transverse gradients.
    # ---------------------------------------------------------------

    u_ax = np.exp(
        -1.0j
        *
        ax
    )

    d_ax = (
        a[
            1:,
            :
        ]
        -
        u_ax
        *
        a[
            :-1,
            :
        ]
    )

    energy += float(
        np.sum(
            r_x_link
            *
            np.abs(
                d_ax
            ) ** 2
        )
    )

    weighted = (
        2.0
        *
        r_x_link
        *
        d_ax
    )

    g_a[
        1:,
        :
    ] += weighted

    g_a[
        :-1,
        :
    ] -= (
        np.conj(
            u_ax
        )
        *
        weighted
    )

    g_ax += (
        -2.0
        *
        r_x_link
        *
        np.imag(
            np.conj(
                d_ax
            )
            *
            u_ax
            *
            a[
                :-1,
                :
            ]
        )
    )

    u_az = np.exp(
        -1.0j
        *
        az
    )

    d_az = (
        a[
            :,
            1:
        ]
        -
        u_az
        *
        a[
            :,
            :-1
        ]
    )

    energy += float(
        np.sum(
            r_z_link
            *
            np.abs(
                d_az
            ) ** 2
        )
    )

    weighted = (
        2.0
        *
        r_z_link
        *
        d_az
    )

    g_a[
        :,
        1:
    ] += weighted

    g_a[
        :,
        :-1
    ] -= (
        np.conj(
            u_az
        )
        *
        weighted
    )

    g_az += (
        -2.0
        *
        r_z_link
        *
        np.imag(
            np.conj(
                d_az
            )
            *
            u_az
            *
            a[
                :,
                :-1
            ]
        )
    )

    # ---------------------------------------------------------------
    # Meridional magnetic gauge field.
    # ---------------------------------------------------------------

    flux = (
        ax[
            :,
            :-1
        ]
        +
        az[
            1:,
            :
        ]
        -
        ax[
            :,
            1:
        ]
        -
        az[
            :-1,
            :
        ]
    )

    gauge_coefficient = (
        1.0
        /
        (
            p.g_x
            *
            p.g_x
            *
            dx
            *
            dx
        )
    )

    energy += (
        0.5
        *
        gauge_coefficient
        *
        float(
            np.sum(
                r_cell
                *
                flux
                *
                flux
            )
        )
    )

    g_flux = (
        gauge_coefficient
        *
        r_cell
        *
        flux
    )

    g_ax[
        :,
        :-1
    ] += g_flux

    g_az[
        1:,
        :
    ] += g_flux

    g_ax[
        :,
        1:
    ] -= g_flux

    g_az[
        :-1,
        :
    ] -= g_flux

    # ---------------------------------------------------------------
    # Node potentials including exact toroidal N^2/r^2 - omega^2.
    # ---------------------------------------------------------------

    h2 = h * h
    phi2 = phi * phi
    sigma2 = sigma * sigma
    amplitude_sq = np.abs(
        a
    ) ** 2

    w_phi = (
        (
            problem.n_phi
            /
            problem.cylindrical_r
        ) ** 2
        -
        problem.omega_phi**2
    )

    w_sigma = (
        (
            problem.n_sigma
            /
            problem.cylindrical_r
        ) ** 2
        -
        problem.omega_sigma**2
    )

    a_phi = (
        w_phi
        +
        p.m_phi_sq
        +
        p.f_phi
        *
        (
            h2
            -
            1.0
        )
    )

    a_sigma = (
        w_sigma
        +
        p.m_sigma_sq
        +
        p.f_sigma
        *
        (
            h2
            -
            1.0
        )
    )

    potential = (
        g2.LAMBDA_H
        /
        8.0
        *
        (
            h2
            -
            1.0
        ) ** 2

        +

        0.5
        *
        a_phi
        *
        phi2

        +

        p.lambda_phi
        /
        4.0
        *
        phi2
        *
        phi2

        +

        0.5
        *
        a_sigma
        *
        sigma2

        +

        p.lambda_sigma
        /
        4.0
        *
        sigma2
        *
        sigma2

        +

        p.g_cross
        /
        2.0
        *
        phi2
        *
        sigma2
    )

    c_h = (
        g2.H_LOCK
        *
        g2.F_A
        *
        g2.F_A
    )

    c_a = (
        2.0
        *
        g2.H_LOCK
    )

    constant = (
        2.0
        *
        g2.H_LOCK
        *
        g2.F_A
        *
        g2.F_A
    )

    trilinear = (
        g2.H_LOCK
        *
        (
            np.conj(
                H
            )
            *
            a
            *
            a

            +

            H
            *
            np.conj(
                a
            )
            *
            np.conj(
                a
            )
        )
    ).real

    potential += (
        g2.LAMBDA_A
        /
        4.0
        *
        (
            amplitude_sq
            -
            g2.F_A
            *
            g2.F_A
        ) ** 2

        -

        trilinear

        +

        c_h
        *
        (
            h2
            -
            1.0
        )

        +

        c_a
        *
        (
            amplitude_sq
            -
            g2.F_A
            *
            g2.F_A
        )

        +

        constant
    )

    g_h_potential = (
        0.5
        *
        g2.LAMBDA_H
        *
        h
        *
        (
            h2
            -
            1.0
        )

        +

        p.f_phi
        *
        h
        *
        phi2

        +

        p.f_sigma
        *
        h
        *
        sigma2

        -

        2.0
        *
        g2.H_LOCK
        *
        np.real(
            np.conj(
                problem.phase
            )
            *
            a
            *
            a
        )

        +

        2.0
        *
        c_h
        *
        h
    )

    g_phi_potential = (
        w_phi

        +

        p.m_phi_sq

        +

        p.f_phi
        *
        (
            h2
            -
            1.0
        )

        +

        p.lambda_phi
        *
        phi2

        +

        p.g_cross
        *
        sigma2
    ) * phi

    g_sigma_potential = (
        w_sigma

        +

        p.m_sigma_sq

        +

        p.f_sigma
        *
        (
            h2
            -
            1.0
        )

        +

        p.lambda_sigma
        *
        sigma2

        +

        p.g_cross
        *
        phi2
    ) * sigma

    g_a_potential = (
        g2.LAMBDA_A
        *
        (
            amplitude_sq
            -
            g2.F_A
            *
            g2.F_A
        )
        *
        a

        +

        2.0
        *
        c_a
        *
        a

        -

        4.0
        *
        g2.H_LOCK
        *
        H
        *
        np.conj(
            a
        )
    )

    node_weight = (
        dx
        *
        dx
        *
        problem.node_weights
        *
        node_cyl
    )

    energy += float(
        np.sum(
            node_weight
            *
            potential
        )
    )

    g_h += (
        node_weight
        *
        g_h_potential
    )

    g_phi += (
        node_weight
        *
        g_phi_potential
    )

    g_sigma += (
        node_weight
        *
        g_sigma_potential
    )

    g_a += (
        node_weight
        *
        g_a_potential
    )

    pieces = [
        g_h[
            problem.h_free
        ],

        g_phi[
            problem.phi_free
        ],

        g_sigma[
            problem.sigma_free
        ],
    ]

    a_gradient = g_a[
        problem.a_free
    ]

    pieces.extend(
        (
            a_gradient.real,
            a_gradient.imag,

            g_ax[
                problem.ax_free
            ],

            g_az[
                problem.az_free
            ],
        )
    )

    return (
        float(
            energy
        ),

        np.concatenate(
            pieces
        ),
    )


def directional_gradient_check(
    g2,
    p,
    problem: ToroidalProblem,
    seed: int,
) -> float:
    """Compare the cylindrical analytic gradient with a centered difference."""

    vector = pack(
        problem
    )

    _, gradient = action_and_gradient(
        g2,
        p,
        problem,
        vector,
    )

    rng = np.random.default_rng(
        seed
    )

    direction = rng.normal(
        size=vector.size
    )

    direction /= np.linalg.norm(
        direction
    )

    epsilon = 5.0e-7

    plus, _ = action_and_gradient(
        g2,
        p,
        problem,
        vector
        +
        epsilon
        *
        direction,
    )

    minus, _ = action_and_gradient(
        g2,
        p,
        problem,
        vector
        -
        epsilon
        *
        direction,
    )

    finite_difference = (
        plus
        -
        minus
    ) / (
        2.0
        *
        epsilon
    )

    analytic = float(
        np.dot(
            gradient,
            direction,
        )
    )

    return (
        abs(
            finite_difference
            -
            analytic
        )
        /
        max(
            abs(
                finite_difference
            ),
            abs(
                analytic
            ),
            1.0e-14,
        )
    )


def set_initial_from_result(
    problem: ToroidalProblem,
    previous: ToroidalResult,
) -> None:
    """Warm-start one continuation stage from the preceding same-grid solution."""

    if (
        problem.n
        !=
        previous.problem.n
        or
        not math.isclose(
            problem.box_half,
            previous.problem.box_half,
            rel_tol=0.0,
            abs_tol=1.0e-12,
        )
    ):
        raise RuntimeError(
            "Warm-start requires identical local continuation grids"
        )

    problem.h0[
        problem.h_free
    ] = previous.h[
        problem.h_free
    ]

    problem.phi0[
        problem.phi_free
    ] = previous.phi[
        problem.phi_free
    ]

    problem.sigma0[
        problem.sigma_free
    ] = previous.sigma[
        problem.sigma_free
    ]

    problem.a0[
        problem.a_free
    ] = previous.a[
        problem.a_free
    ]

    problem.ax0[
        problem.ax_free
    ] = previous.ax[
        problem.ax_free
    ]

    problem.az0[
        problem.az_free
    ] = previous.az[
        problem.az_free
    ]


def matching_derivative_mismatch(
    problem: ToroidalProblem,
    h,
    phi,
    sigma,
    a,
    ax,
    az,
) -> float:
    """Measure C1 mismatch against independently reconstructed outer data.

    The boundary values themselves are Dirichlet matched exactly.  This metric
    compares the first interior normal difference with the same normal
    difference of the continuum-matched initialization.

    It is intentionally dimensionless and aggregated across all released field
    channels.
    """

    differences = []
    references = []

    for field, reference in (
        (
            h,
            problem.h0,
        ),
        (
            phi,
            problem.phi0,
        ),
        (
            sigma,
            problem.sigma0,
        ),
        (
            a.real,
            problem.a0.real,
        ),
        (
            a.imag,
            problem.a0.imag,
        ),
    ):

        for solved_delta, reference_delta in (
            (
                field[
                    1,
                    :
                ]
                -
                field[
                    0,
                    :
                ],

                reference[
                    1,
                    :
                ]
                -
                reference[
                    0,
                    :
                ],
            ),

            (
                field[
                    -1,
                    :
                ]
                -
                field[
                    -2,
                    :
                ],

                reference[
                    -1,
                    :
                ]
                -
                reference[
                    -2,
                    :
                ],
            ),

            (
                field[
                    :,
                    1
                ]
                -
                field[
                    :,
                    0
                ],

                reference[
                    :,
                    1
                ]
                -
                reference[
                    :,
                    0
                ],
            ),

            (
                field[
                    :,
                    -1
                ]
                -
                field[
                    :,
                    -2
                ],

                reference[
                    :,
                    -1
                ]
                -
                reference[
                    :,
                    -2
                ],
            ),
        ):

            differences.append(
                np.ravel(
                    solved_delta
                    -
                    reference_delta
                )
            )

            references.append(
                np.ravel(
                    reference_delta
                )
            )

    # Gauge links are already line-integrated derivatives.  Compare only the
    # first free layers adjacent to the fixed outer boundary; comparing the
    # complete interior would incorrectly count legitimate curved-core
    # relaxation as a matching failure.
    for field, reference in (
        (ax, problem.ax0),
        (az, problem.az0),
    ):

        solved_edge = np.concatenate(
            (
                np.ravel(field[1, :]),
                np.ravel(field[-2, :]),
                np.ravel(field[:, 1]),
                np.ravel(field[:, -2]),
            )
        )

        reference_edge = np.concatenate(
            (
                np.ravel(reference[1, :]),
                np.ravel(reference[-2, :]),
                np.ravel(reference[:, 1]),
                np.ravel(reference[:, -2]),
            )
        )

        differences.append(
            solved_edge
            -
            reference_edge
        )

        references.append(
            reference_edge
        )

    difference = np.concatenate(
        differences
    )

    reference = np.concatenate(
        references
    )

    return float(
        np.linalg.norm(
            difference
        )
        /
        max(
            np.linalg.norm(
                reference
            ),
            math.sqrt(
                reference.size
            )
            *
            1.0e-3,
        )
    )


def topology_metrics(
    g2,
    p,
    result_fields,
    problem: ToroidalProblem,
):
    """Return one-wall, phase-lock, flux, and carrier diagnostics."""

    (
        h,
        phi,
        sigma,
        a,
        ax,
        az,
    ) = result_fields

    iz0 = int(
        np.argmin(
            np.abs(
                problem.z
            )
        )
    )

    ix_negative = int(
        np.argmin(
            np.abs(
                problem.x
                +
                0.5
                *
                problem.box_half
            )
        )
    )

    ix_positive = int(
        np.argmin(
            np.abs(
                problem.x
                -
                0.5
                *
                problem.box_half
            )
        )
    )

    wall_contrast = (
        abs(
            a[
                ix_negative,
                iz0
            ]
        )
        /
        max(
            abs(
                a[
                    ix_positive,
                    iz0
                ]
            ),
            1.0e-30,
        )
    )

    H = (
        h
        *
        problem.phase
    )

    relative = (
        np.conj(
            H
        )
        *
        a
        *
        a
    )

    mask = (
        (
            np.abs(
                a
            )
            >
            0.40
            *
            g2.F_A
        )

        &

        (
            h
            >
            0.40
        )
    )

    if np.count_nonzero(
        mask
    ) == 0:

        phase_lock_cos = -1.0

    else:

        cosine = (
            np.real(
                relative
            )
            /
            (
                np.abs(
                    relative
                )
                +
                1.0e-30
            )
        )

        phase_weights = (
            np.abs(
                a
            ) ** 2
            *
            h**2
        )

        phase_lock_cos = float(
            np.average(
                cosine[
                    mask
                ],
                weights=phase_weights[
                    mask
                ],
            )
        )

    flux = (
        ax[
            :,
            :-1
        ]
        +
        az[
            1:,
            :
        ]
        -
        ax[
            :,
            1:
        ]
        -
        az[
            :-1,
            :
        ]
    )

    flux_angle = float(
        np.sum(
            flux
        )
    )

    node_factor = (
        problem.node_weights
        *
        problem.cylindrical_r
        /
        problem.R
    )

    sigma_phi_normalized = (
        problem.dx
        *
        problem.dx
        *
        float(
            np.sum(
                node_factor
                *
                phi
                *
                phi
            )
        )
    )

    sigma_sigma_normalized = (
        problem.dx
        *
        problem.dx
        *
        float(
            np.sum(
                node_factor
                *
                sigma
                *
                sigma
            )
        )
    )

    return (
        wall_contrast,
        phase_lock_cos,
        flux_angle,
        sigma_phi_normalized,
        sigma_sigma_normalized,
    )


def solve_problem(
    g2,
    p,
    problem: ToroidalProblem,
    reference_problem: ToroidalProblem,
) -> ToroidalResult:
    """Relax one cylindrical continuation stage."""

    initial = pack(
        problem
    )

    result = minimize(
        lambda vector:
            action_and_gradient(
                g2,
                p,
                problem,
                vector,
            ),

        initial,

        method="L-BFGS-B",

        jac=True,

        bounds=bounds(
            problem
        ),

        options={
            "maxiter":
                MAXITER,

            "ftol":
                1.0e-13,

            "gtol":
                1.0e-8,

            "maxls":
                50,

            "maxcor":
                20,
        },
    )

    normalized_action, gradient = (
        action_and_gradient(
            g2,
            p,
            problem,
            result.x,
        )
    )

    gradient_rms = float(
        np.linalg.norm(
            gradient
        )
        /
        math.sqrt(
            gradient.size
        )
    )

    gradient_max = float(
        np.max(
            np.abs(
                gradient
            )
        )
    )

    fields = unpack(
        problem,
        result.x,
    )

    (
        h,
        phi,
        sigma,
        a,
        ax,
        az,
    ) = fields

    (
        wall_contrast,
        phase_lock_cos,
        flux_angle,
        sigma_phi_normalized,
        sigma_sigma_normalized,
    ) = topology_metrics(
        g2,
        p,
        fields,
        problem,
    )

    matching_mismatch = matching_derivative_mismatch(
        reference_problem,
        h,
        phi,
        sigma,
        a,
        ax,
        az,
    )

    regularity_pass = bool(
        np.all(
            np.isfinite(
                h
            )
        )
        and
        np.all(
            np.isfinite(
                phi
            )
        )
        and
        np.all(
            np.isfinite(
                sigma
            )
        )
        and
        np.all(
            np.isfinite(
                a.real
            )
        )
        and
        np.all(
            np.isfinite(
                a.imag
            )
        )
        and
        np.all(
            np.isfinite(
                ax
            )
        )
        and
        np.all(
            np.isfinite(
                az
            )
        )
        and
        np.min(
            h
        )
        >=
        -1.0e-10
        and
        np.max(
            h
        )
        <=
        1.5
        +
        1.0e-10
        and
        np.min(
            phi
        )
        >=
        -1.0e-10
        and
        np.min(
            sigma
        )
        >=
        -1.0e-10
    )

    return ToroidalResult(
        problem=problem,

        normalized_action=normalized_action,
        gradient_rms=gradient_rms,
        gradient_max=gradient_max,

        optimizer_success=bool(
            result.success
        ),
        iterations=int(
            result.nit
        ),

        h=h,
        phi=phi,
        sigma=sigma,
        a=a,
        ax=ax,
        az=az,

        sigma_phi_normalized=sigma_phi_normalized,
        sigma_sigma_normalized=sigma_sigma_normalized,

        wall_contrast=wall_contrast,
        phase_lock_cos=phase_lock_cos,
        flux_angle=flux_angle,

        matching_mismatch=matching_mismatch,
        regularity_pass=regularity_pass,
    )


def relative_field_change(
    previous: ToroidalResult,
    current: ToroidalResult,
) -> float:
    """Return RMS relative displacement between successive continuation fields."""

    arrays_previous = (
        previous.h,
        previous.phi,
        previous.sigma,
        previous.a.real,
        previous.a.imag,
        previous.ax,
        previous.az,
    )

    arrays_current = (
        current.h,
        current.phi,
        current.sigma,
        current.a.real,
        current.a.imag,
        current.ax,
        current.az,
    )

    numerator = 0.0
    denominator = 0.0

    for old, new in zip(
        arrays_previous,
        arrays_current,
    ):

        numerator += float(
            np.sum(
                (
                    new
                    -
                    old
                ) ** 2
            )
        )

        denominator += float(
            np.sum(
                old**2
            )
        )

    return math.sqrt(
        numerator
        /
        max(
            denominator,
            1.0e-30,
        )
    )


