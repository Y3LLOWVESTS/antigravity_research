def load_module(name: str, path: Path):
    """Import one repository simulation without invoking its main function."""

    spec = importlib.util.spec_from_file_location(name, path)

    if spec is None or spec.loader is None:
        raise RuntimeError(f"Cannot import {path}")

    module = importlib.util.module_from_spec(spec)
    sys.modules[name] = module

    try:
        spec.loader.exec_module(module)
    except Exception:
        sys.modules.pop(name, None)
        raise

    return module


def require_marker(path: Path, marker: str) -> None:
    """Require a GREEN upstream marker before inheriting its outputs."""

    if not path.exists():
        raise RuntimeError(f"Missing upstream artifact: {path}")

    text = path.read_text(errors="replace")

    if marker not in text:
        raise RuntimeError(f"Missing upstream marker {marker!r} in {path}")


def scalar(path: Path, label: str) -> float:
    """Read one finite floating-point scalar following an exact label."""

    text = path.read_text(errors="replace")

    number = r"([+-]?(?:\d+(?:\.\d*)?|\.\d+)(?:[eE][+-]?\d+)?)"

    match = re.search(
        re.escape(label) + number,
        text,
    )

    if match is None:
        raise RuntimeError(f"Missing {label!r} in {path}")

    value = float(match.group(1))

    if not math.isfinite(value):
        raise RuntimeError(f"Nonfinite {label!r} in {path}")

    return value


def integer_scalar(path: Path, label: str) -> int:
    """Read one signed integer following an exact label."""

    text = path.read_text(errors="replace")

    match = re.search(
        re.escape(label) + r"([+-]?\d+)",
        text,
    )

    if match is None:
        raise RuntimeError(f"Missing integer {label!r} in {path}")

    return int(match.group(1))


def scaled_integer(value: int, ratio: Fraction) -> int:
    """Scale an exact winding by a rational continuation ratio."""

    numerator = value * ratio.numerator

    if numerator % ratio.denominator != 0:
        raise RuntimeError(
            "Continuation ratio does not preserve integer winding: "
            f"value={value} ratio={ratio}"
        )

    return numerator // ratio.denominator


def build_problem(
    g2,
    p,
    data,
    *,
    R: float,
    n_phi: int,
    n_sigma: int,
    omega_phi: float,
    omega_sigma: float,
    n: int = PRIMARY_N,
    box_half: float = PRIMARY_BOX_HALF,
    blend_factor: float = PRIMARY_BLEND_FACTOR,
) -> ToroidalProblem:
    """Build one cylindrical curved-rim patch from the established continuum data."""

    x = np.linspace(
        -box_half,
        box_half,
        n,
    )

    z = np.linspace(
        -box_half,
        box_half,
        n,
    )

    dx = float(
        x[1]
        -
        x[0]
    )

    X, Z = np.meshgrid(
        x,
        z,
        indexing="ij",
    )

    cylindrical_r = (
        R
        +
        X
    )

    if np.min(cylindrical_r) <= 0.0:
        raise RuntimeError(
            "Local toroidal patch crossed the cylindrical axis"
        )

    core_radius = np.hypot(
        X,
        Z,
    )

    theta = np.arctan2(
        Z,
        X,
    )

    phase = np.exp(
        1.0j
        *
        theta
    )

    phase[
        core_radius
        <
        1.0e-14
    ] = 1.0 + 0.0j

    h_radial, _Q_node, phi_radial, sigma_radial = g2.radial_values(
        data,
        np.maximum(
            core_radius,
            g2.RADIAL_EPS,
        ),
    )

    x_mid = (
        0.5
        *
        (
            x[:-1, None]
            +
            x[1:, None]
        )
    )

    z_on_x = np.broadcast_to(
        z[None, :],
        (
            n - 1,
            n,
        ),
    )

    core_mid_x = np.hypot(
        x_mid,
        z_on_x,
    )

    Q_mid_x = g2.radial_values(
        data,
        np.maximum(
            core_mid_x,
            g2.RADIAL_EPS,
        ),
    )[
        1
    ]

    ax0 = (
        0.5
        *
        (
            Q_mid_x
            -
            1.0
        )
        *
        (
            -z_on_x
            /
            np.maximum(
                core_mid_x
                *
                core_mid_x,
                1.0e-14,
            )
        )
        *
        dx
    )

    x_on_z = np.broadcast_to(
        x[:, None],
        (
            n,
            n - 1,
        ),
    )

    z_mid = (
        0.5
        *
        (
            z[None, :-1]
            +
            z[None, 1:]
        )
    )

    core_mid_z = np.hypot(
        x_on_z,
        z_mid,
    )

    Q_mid_z = g2.radial_values(
        data,
        np.maximum(
            core_mid_z,
            g2.RADIAL_EPS,
        ),
    )[
        1
    ]

    az0 = (
        0.5
        *
        (
            Q_mid_z
            -
            1.0
        )
        *
        (
            x_on_z
            /
            np.maximum(
                core_mid_z
                *
                core_mid_z,
                1.0e-14,
            )
        )
        *
        dx
    )

    H_wall, A_wall_abs = g2.planar_wall_values(
        data,
        Z,
    )

    blend_width = (
        blend_factor
        *
        p.core_width
    )

    blend = (
        0.5
        *
        (
            1.0
            -
            np.tanh(
                X
                /
                blend_width
            )
        )
    )

    h0 = (
        h_radial
        +
        blend
        *
        (
            H_wall
            -
            1.0
        )
    )

    phi0 = phi_radial.copy()
    sigma0 = sigma_radial.copy()

    amplitude = (
        g2.F_A
        +
        blend
        *
        (
            A_wall_abs
            -
            g2.F_A
        )
    )

    a0 = (
        amplitude
        *
        np.exp(
            0.5j
            *
            theta
        )
    )

    center = (
        n // 2,
        n // 2,
    )

    h0[
        center
    ] = 0.0

    a0[
        center
    ] = 0.0 + 0.0j

    node_weights = np.ones(
        (
            n,
            n,
        ),
        dtype=float,
    )

    node_weights[
        [
            0,
            -1,
        ],
        :
    ] *= 0.5

    node_weights[
        :,
        [
            0,
            -1,
        ]
    ] *= 0.5

    node_free = np.zeros(
        (
            n,
            n,
        ),
        dtype=bool,
    )

    node_free[
        1:-1,
        1:-1
    ] = True

    h_free = node_free.copy()
    h_free[
        center
    ] = False

    phi_free = node_free.copy()
    sigma_free = node_free.copy()
    a_free = node_free.copy()

    ax_free = np.zeros(
        (
            n - 1,
            n,
        ),
        dtype=bool,
    )

    ax_free[
        1:-1,
        1:-1
    ] = True

    az_free = np.zeros(
        (
            n,
            n - 1,
        ),
        dtype=bool,
    )

    az_free[
        1:-1,
        1:-1
    ] = True

    return ToroidalProblem(
        n=n,
        box_half=box_half,
        dx=dx,

        R=R,
        n_phi=n_phi,
        n_sigma=n_sigma,

        omega_phi=omega_phi,
        omega_sigma=omega_sigma,

        x=x,
        z=z,
        X=X,
        Z=Z,

        cylindrical_r=cylindrical_r,
        core_radius=core_radius,
        phase=phase,

        node_weights=node_weights,

        h0=h0,
        phi0=phi0,
        sigma0=sigma0,
        a0=a0,
        ax0=ax0,
        az0=az0,

        h_free=h_free,
        phi_free=phi_free,
        sigma_free=sigma_free,
        a_free=a_free,
        ax_free=ax_free,
        az_free=az_free,
    )


def pack(problem: ToroidalProblem) -> np.ndarray:
    """Pack all released fields into one deterministic real vector."""

    a_values = problem.a0[
        problem.a_free
    ]

    return np.concatenate(
        (
            problem.h0[
                problem.h_free
            ],

            problem.phi0[
                problem.phi_free
            ],

            problem.sigma0[
                problem.sigma_free
            ],

            a_values.real,
            a_values.imag,

            problem.ax0[
                problem.ax_free
            ],

            problem.az0[
                problem.az_free
            ],
        )
    )


def unpack(
    problem: ToroidalProblem,
    vector: np.ndarray,
):
    """Restore one optimizer vector to the complete field arrays."""

    h = problem.h0.copy()
    phi = problem.phi0.copy()
    sigma = problem.sigma0.copy()
    a = problem.a0.copy()
    ax = problem.ax0.copy()
    az = problem.az0.copy()

    offset = 0

    for array, mask in (
        (
            h,
            problem.h_free,
        ),
        (
            phi,
            problem.phi_free,
        ),
        (
            sigma,
            problem.sigma_free,
        ),
    ):

        count = int(
            np.count_nonzero(
                mask
            )
        )

        array[
            mask
        ] = vector[
            offset
            :
            offset
            +
            count
        ]

        offset += count

    count_a = int(
        np.count_nonzero(
            problem.a_free
        )
    )

    real = vector[
        offset
        :
        offset
        +
        count_a
    ]

    offset += count_a

    imag = vector[
        offset
        :
        offset
        +
        count_a
    ]

    offset += count_a

    a[
        problem.a_free
    ] = (
        real
        +
        1.0j
        *
        imag
    )

    count = int(
        np.count_nonzero(
            problem.ax_free
        )
    )

    ax[
        problem.ax_free
    ] = vector[
        offset
        :
        offset
        +
        count
    ]

    offset += count

    count = int(
        np.count_nonzero(
            problem.az_free
        )
    )

    az[
        problem.az_free
    ] = vector[
        offset
        :
        offset
        +
        count
    ]

    offset += count

    if offset != vector.size:
        raise RuntimeError(
            "Toroidal optimizer pack/unpack size mismatch"
        )

    return (
        h,
        phi,
        sigma,
        a,
        ax,
        az,
    )


