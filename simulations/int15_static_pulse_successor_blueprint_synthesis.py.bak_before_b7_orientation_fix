def independent_teacher_force(
    int14c,
    arrays: dict[str, np.ndarray],
    payload_z: float,
    payload_radius: float,
) -> dict[str, Any]:
    r_edges = arrays["r_edges"]
    z_edges = arrays["z_edges"]
    active_density = arrays["active_density"]

    nr, nz = active_density.shape

    kernels_hi = np.zeros_like(
        active_density,
        dtype=float,
    )

    for i in range(nr):
        for j in range(nz):
            kernels_hi[i, j] = (
                int14c.independent_cell_kernel(
                    float(r_edges[i]),
                    float(r_edges[i + 1]),
                    float(z_edges[j]),
                    float(z_edges[j + 1]),
                    float(payload_z),
                    float(payload_radius),
                )
            )

    A_base = float(
        np.sum(
            arrays["kernels"]
            * active_density
        )
    )

    A_hi = float(
        np.sum(
            kernels_hi
            * active_density
        )
    )

    rel = relative_error(
        A_base,
        A_hi,
    )

    return {
        "A_base": A_base,
        "A_independent_high_order": A_hi,
        "relative_error": rel,
        "pass": bool(
            A_hi > 0.0
            and rel
            <= FORCE_REPRO_REL_TOL
        ),
        "kernels_hi": kernels_hi,
    }


def rebuild_exact_b7(
    int02,
    a23,
    b23,
) -> dict[str, Any]:
    degree, I = (
        b23.angular_integrals_b7(
            b23.B7_B0
        )
    )

    profile = (
        b23.solve_profile_with_custom_I(
            a23,
            B,
            ETA,
            MASS,
            I,
        )
    )

    sector_profiles, sector_energies = (
        b23.solve_exact_sector(
            a23,
            ETA,
            MASS,
        )
    )

    if not all(
        p.success
        for p in sector_profiles.values()
    ):
        raise RuntimeError(
            "Exact B=7 sector solve failed"
        )

    candidate = (
        b23.candidate_from_sector(
            a23,
            sector_profiles,
            sector_energies,
            B,
        )
    )

    payload = candidate.payload

    (
        xyz,
        energy_w,
        active_w,
        e4_w,
        v_w,
    ) = int02.exact_map_weighted_source(
        b23,
        profile,
        b23.B7_B0,
        EXACT_NR,
        EXACT_NMU,
        EXACT_NPHI,
    )

    h = float(
        payload.payload_center
    )
    rp = float(
        payload.payload_radius
    )

    q = xyz.copy()
    q[:, 2] -= h

    d2 = np.sum(
        q * q,
        axis=1,
    )
    d = np.sqrt(d2)

    K = (
        q[:, 2]
        / np.maximum(
            d2 * d,
            rp**3,
        )
    )

    influence = (
        active_w * K
    )

    outward = np.maximum(
        influence,
        0.0,
    )

    E = float(
        np.sum(
            energy_w
        )
    )
    A = float(
        np.sum(
            influence
        )
    )

    S_over_rho = (
        active_w
        / np.maximum(
            energy_w,
            1.0e-300,
        )
    )

    return {
        "degree": float(degree),
        "I": float(I),
        "profile": profile,
        "candidate": candidate,
        "xyz": xyz,
        "energy_w": energy_w,
        "active_w": active_w,
        "e4_w": e4_w,
        "v_w": v_w,
        "K": K,
        "influence": influence,
        "outward": outward,
        "S_over_rho": S_over_rho,
        "E": E,
        "A": A,
        "h": h,
        "payload_radius": rp,
        "payload_radius_over_h": (
            rp / h
        ),
        "shell_radius_over_h": float(
            profile.shell_radius
            / h
        ),
    }


def bin_exact_to_teacher(
    exact: dict[str, Any],
    arrays: dict[str, np.ndarray],
) -> dict[str, np.ndarray]:
    r_edges = arrays["r_edges"]
    z_edges = arrays["z_edges"]

    shape = arrays["e"].shape

    energy = np.zeros(
        shape,
        dtype=float,
    )
    active = np.zeros_like(
        energy
    )
    influence = np.zeros_like(
        energy
    )
    outward = np.zeros_like(
        energy
    )

    xyz = exact["xyz"]
    h = float(
        exact["h"]
    )

    r = np.sqrt(
        xyz[:, 0] ** 2
        + xyz[:, 1] ** 2
    ) / h
    z = (
        xyz[:, 2]
        / h
    )

    ir = (
        np.searchsorted(
            r_edges,
            r,
            side="right",
        )
        - 1
    )
    iz = (
        np.searchsorted(
            z_edges,
            z,
            side="right",
        )
        - 1
    )

    good = (
        (ir >= 0)
        & (ir < shape[0])
        & (iz >= 0)
        & (iz < shape[1])
    )

    for i, j, ew, aw, iw, ow in zip(
        ir[good],
        iz[good],
        exact["energy_w"][good],
        exact["active_w"][good],
        exact["influence"][good],
        exact["outward"][good],
    ):
        energy[i, j] += ew
        active[i, j] += aw
        influence[i, j] += iw
        outward[i, j] += ow

    return {
        "energy": energy,
        "active": active,
        "influence": influence,
        "outward": outward,
    }


def cross_overlap(
    teacher_energy: np.ndarray,
    teacher_outward: np.ndarray,
    exact_energy: np.ndarray,
    exact_outward: np.ndarray,
    teacher_mask: np.ndarray,
    exact_mask: np.ndarray,
) -> dict[str, float]:
    def frac(x, mask):
        return float(
            np.sum(
                x[mask]
            )
            / max(
                float(
                    np.sum(x)
                ),
                1.0e-300,
            )
        )

    return {
        "b7_energy_in_teacher_mask": (
            frac(
                exact_energy,
                teacher_mask,
            )
        ),
        "b7_outward_in_teacher_mask": (
            frac(
                exact_outward,
                teacher_mask,
            )
        ),
        "teacher_energy_in_b7_mask": (
            frac(
                teacher_energy,
                exact_mask,
            )
        ),
        "teacher_outward_in_b7_mask": (
            frac(
                teacher_outward,
                exact_mask,
            )
        ),
    }


def pulse_matrix(
    *,
    current_C: float,
    teacher_C: float,
    c006d: float,
    r99: float,
    force_length: float,
) -> tuple[list[dict[str, Any]], dict[str, Any]]:
    rows = []

    C_sources = {
        "B7_CURRENT": current_C,
        "006D_ROBUST": c006d,
        "INT14D_N48_TEACHER_DIAGNOSTIC": teacher_C,
    }

    alpha_values = (
        0.10,
        0.25,
        0.50,
    )

    theta_values = (
        2.0 * r99,
        10.0 * r99,
        30.0 * r99,
        100.0 * r99,
    )

    for source_name, C in C_sources.items():
        for alpha in alpha_values:
            for theta in theta_values:
                area_fraction = (
                    1.0 - alpha
                )
                Q = (
                    theta
                    * area_fraction
                )

                ramp_theta = (
                    alpha
                    * theta
                )

                max_d1 = (
                    math.pi
                    / (
                        2.0
                        * alpha
                        * theta
                    )
                )

                max_d2 = (
                    math.pi**2
                    / (
                        2.0
                        * alpha**2
                        * theta**2
                    )
                )

                B1_prod = (
                    force_length
                    * max_d1
                )
                B2_prod = (
                    force_length**2
                    * max_d2
                )
                B1_global = (
                    r99
                    * max_d1
                )
                B2_global = (
                    r99**2
                    * max_d2
                )

                boundary_causal = bool(
                    ramp_theta >= r99
                )

                rows.append({
                    "source": source_name,
                    "C": C,
                    "alpha_each_ramp": alpha,
                    "theta_total_cT_over_h": theta,
                    "envelope_area_fraction": area_fraction,
                    "Q_integral_f_dtheta": Q,
                    "Xi_seed_Q_over_C": (
                        Q / C
                    ),
                    "ramp_theta": ramp_theta,
                    "boundary_fed_global_causal": boundary_causal,
                    "B1_productive": B1_prod,
                    "B2_productive": B2_prod,
                    "B1_global": B1_global,
                    "B2_global": B2_global,
                })

    raw_headroom = (
        current_C / teacher_C
    )

    overhead_budgets = {}

    for target in (
        1000.0,
        100.0,
        10.0,
        1.0,
    ):
        budget = (
            raw_headroom / target
        )

        table = []

        for kappa in (
            1.0,
            2.0,
            5.0,
            10.0,
            20.0,
            50.0,
        ):
            if budget > 0.0:
                zeta_max = (
                    1.0
                    - kappa / budget
                )
            else:
                zeta_max = float("nan")

            feasible = bool(
                zeta_max >= 0.0
            )

            table.append({
                "kappa_cycle": kappa,
                "maximum_return_cancellation_fraction": (
                    max(
                        min(
                            zeta_max,
                            1.0,
                        ),
                        0.0,
                    )
                    if feasible
                    else float("nan")
                ),
                "feasible": feasible,
            })

        overhead_budgets[
            f"retain_{int(target)}x"
        ] = {
            "maximum_effective_cycle_penalty": budget,
            "examples": table,
        }

    physical_duration_examples = []

    for h_m in (
        0.01,
        0.10,
        1.0,
    ):
        for theta_factor in (
            10.0,
            30.0,
            100.0,
        ):
            theta = (
                theta_factor
                * r99
            )
            T = (
                theta
                * h_m
                / C_LIGHT
            )

            physical_duration_examples.append({
                "h_m": h_m,
                "theta_over_R99": theta_factor,
                "theta_total": theta,
                "duration_seconds": T,
            })

    return rows, {
        "raw_teacher_headroom_vs_B7": raw_headroom,
        "overhead_budgets": overhead_budgets,
        "physical_duration_examples": physical_duration_examples,
        "dynamic_completion_warning": (
            "Pulse Xi values are ideal peak-state seed metrics only. "
            "A conserved dynamic Tmunu and complete creation/collapse/reset "
            "cycle have not been constructed."
        ),
    }


