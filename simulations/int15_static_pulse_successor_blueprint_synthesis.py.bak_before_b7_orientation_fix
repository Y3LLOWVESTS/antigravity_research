def require(path: Path) -> None:
    if not path.is_file():
        raise RuntimeError(f"Required file missing: {path}")


def load_module(name: str, path: Path):
    spec = importlib.util.spec_from_file_location(name, path)
    if spec is None or spec.loader is None:
        raise RuntimeError(f"Cannot import {path}")
    module = importlib.util.module_from_spec(spec)
    sys.modules[name] = module
    spec.loader.exec_module(module)
    return module


def relative_error(a: float, b: float) -> float:
    return abs(a - b) / max(abs(a), abs(b), 1.0e-300)


def weighted_quantile(
    values: np.ndarray,
    weights: np.ndarray,
    quantiles=(0.05, 0.25, 0.50, 0.75, 0.95),
) -> dict[str, float]:
    v = np.asarray(values, dtype=float).ravel()
    w = np.asarray(weights, dtype=float).ravel()

    good = (
        np.isfinite(v)
        & np.isfinite(w)
        & (w > 0.0)
    )

    v = v[good]
    w = w[good]

    if len(v) == 0 or float(np.sum(w)) <= 0.0:
        return {
            f"q{int(round(100*q)):02d}": float("nan")
            for q in quantiles
        }

    order = np.argsort(v)
    v = v[order]
    w = w[order]

    cumulative = np.cumsum(w)
    cumulative /= cumulative[-1]

    out = {}

    for q in quantiles:
        out[f"q{int(round(100*q)):02d}"] = float(
            np.interp(
                q,
                cumulative,
                v,
            )
        )

    return out


def cosine_similarity(
    a: np.ndarray,
    b: np.ndarray,
) -> float:
    x = np.asarray(a, dtype=float).ravel()
    y = np.asarray(b, dtype=float).ravel()

    denom = (
        float(np.linalg.norm(x))
        * float(np.linalg.norm(y))
    )

    if denom <= 0.0:
        return float("nan")

    return float(
        np.dot(x, y)
        / denom
    )


def normalize_nonnegative(a: np.ndarray) -> np.ndarray:
    x = np.maximum(
        np.asarray(a, dtype=float),
        0.0,
    )
    total = float(np.sum(x))

    if total <= 0.0:
        return np.zeros_like(x)

    return x / total


def jensen_shannon_divergence(
    a: np.ndarray,
    b: np.ndarray,
) -> float:
    p = normalize_nonnegative(a).ravel()
    q = normalize_nonnegative(b).ravel()

    m = 0.5 * (p + q)

    def kl(x, y):
        good = x > 0.0
        return float(
            np.sum(
                x[good]
                * np.log(
                    x[good]
                    / np.maximum(
                        y[good],
                        1.0e-300,
                    )
                )
            )
        )

    return 0.5 * kl(p, m) + 0.5 * kl(q, m)


def top_leverage_mask(
    energy: np.ndarray,
    outward: np.ndarray,
    fraction: float,
) -> tuple[np.ndarray, float]:
    e = np.asarray(energy, dtype=float).ravel()
    f = np.asarray(outward, dtype=float).ravel()

    total_f = float(np.sum(np.maximum(f, 0.0)))
    total_e = float(np.sum(np.maximum(e, 0.0)))

    mask_flat = np.zeros_like(
        e,
        dtype=bool,
    )

    if total_f <= 0.0 or total_e <= 0.0:
        return mask_flat.reshape(
            np.asarray(energy).shape
        ), float("nan")

    leverage = np.zeros_like(e)

    floor = max(
        float(np.max(e)),
        1.0,
    ) * 1.0e-15

    good = e > floor
    leverage[good] = (
        np.maximum(f[good], 0.0)
        / e[good]
    )

    order = np.argsort(
        leverage
    )[::-1]

    cumulative = np.cumsum(
        np.maximum(
            f[order],
            0.0,
        )
    )

    index = int(
        np.searchsorted(
            cumulative,
            fraction * total_f,
            side="left",
        )
    )
    index = min(
        index,
        len(order) - 1,
    )

    selected = order[: index + 1]
    mask_flat[selected] = True

    energy_fraction = float(
        np.sum(
            np.maximum(
                e[selected],
                0.0,
            )
        )
        / total_e
    )

    return (
        mask_flat.reshape(
            np.asarray(energy).shape
        ),
        energy_fraction,
    )


def connected_components_4(mask: np.ndarray) -> list[list[tuple[int, int]]]:
    m = np.asarray(mask, dtype=bool)
    nr, nz = m.shape

    seen = np.zeros_like(
        m,
        dtype=bool,
    )

    components = []

    for i in range(nr):
        for j in range(nz):
            if not m[i, j] or seen[i, j]:
                continue

            stack = [(i, j)]
            seen[i, j] = True
            component = []

            while stack:
                ci, cj = stack.pop()
                component.append((ci, cj))

                for ni, nj in (
                    (ci - 1, cj),
                    (ci + 1, cj),
                    (ci, cj - 1),
                    (ci, cj + 1),
                ):
                    if (
                        0 <= ni < nr
                        and 0 <= nj < nz
                        and m[ni, nj]
                        and not seen[ni, nj]
                    ):
                        seen[ni, nj] = True
                        stack.append(
                            (ni, nj)
                        )

            components.append(component)

    return components


def stress_eigenvalues(
    pr: np.ndarray,
    pz: np.ndarray,
    pphi: np.ndarray,
    trz: np.ndarray,
) -> np.ndarray:
    pr = np.asarray(pr, dtype=float)
    pz = np.asarray(pz, dtype=float)
    pphi = np.asarray(pphi, dtype=float)
    trz = np.asarray(trz, dtype=float)

    mean = 0.5 * (
        pr + pz
    )
    radius = np.sqrt(
        0.25 * (
            pr - pz
        ) ** 2
        + trz**2
    )

    lam_a = mean - radius
    lam_b = mean + radius
    lam_c = pphi

    stack = np.stack(
        [
            lam_a,
            lam_b,
            lam_c,
        ],
        axis=-1,
    )

    return np.sort(
        stack,
        axis=-1,
    )


def geometry_summary(
    mask: np.ndarray,
    weights: np.ndarray,
    r_centers: np.ndarray,
    z_centers: np.ndarray,
    payload_z: float,
    payload_radius: float,
) -> dict[str, Any]:
    m = np.asarray(mask, dtype=bool)
    w = np.asarray(weights, dtype=float)

    R, Z = np.meshgrid(
        r_centers,
        z_centers,
        indexing="ij",
    )

    selected = (
        m
        & np.isfinite(w)
        & (w > 0.0)
    )

    if not np.any(selected):
        return {
            "weight": 0.0,
            "r_mean": float("nan"),
            "z_mean": float("nan"),
            "r_min": float("nan"),
            "r_max": float("nan"),
            "z_min": float("nan"),
            "z_max": float("nan"),
            "payload_surface_distance_mean": float("nan"),
            "payload_surface_distance_min": float("nan"),
            "component_count": 0,
        }

    ws = w[selected]
    rs = R[selected]
    zs = Z[selected]

    distance_center = np.sqrt(
        rs**2
        + (
            zs - payload_z
        ) ** 2
    )

    distance_surface = np.abs(
        distance_center
        - payload_radius
    )

    components = connected_components_4(
        m
    )

    return {
        "weight": float(
            np.sum(ws)
        ),
        "r_mean": float(
            np.sum(ws * rs)
            / np.sum(ws)
        ),
        "z_mean": float(
            np.sum(ws * zs)
            / np.sum(ws)
        ),
        "r_min": float(np.min(rs)),
        "r_max": float(np.max(rs)),
        "z_min": float(np.min(zs)),
        "z_max": float(np.max(zs)),
        "payload_surface_distance_mean": float(
            np.sum(
                ws
                * distance_surface
            )
            / np.sum(ws)
        ),
        "payload_surface_distance_min": float(
            np.min(
                distance_surface
            )
        ),
        "component_count": int(
            len(components)
        ),
        "largest_component_cells": int(
            max(
                (
                    len(c)
                    for c in components
                ),
                default=0,
            )
        ),
    }


