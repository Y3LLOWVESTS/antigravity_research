            signed_ledger[
                f"{s_label}_{k_label}"
            ] = float(
                np.sum(
                    cell_force[
                        selected
                    ]
                )
            )

    signed_sum = float(
        sum(
            signed_ledger.values()
        )
    )

    stress_stats = {
        "energy_weighted": {
            "S_over_rho": weighted_quantile(
                S_over_rho[good],
                cell_energy[good],
            ),
            "lambda_min_over_rho": weighted_quantile(
                ratios[..., 0][good],
                cell_energy[good],
            ),
            "lambda_mid_over_rho": weighted_quantile(
                ratios[..., 1][good],
                cell_energy[good],
            ),
            "lambda_max_over_rho": weighted_quantile(
                ratios[..., 2][good],
                cell_energy[good],
            ),
            "anisotropy_over_rho": weighted_quantile(
                anisotropy[good],
                cell_energy[good],
            ),
            "dec_ratio": weighted_quantile(
                dec_ratio[good],
                cell_energy[good],
            ),
        },
        "outward_force_weighted": {
            "S_over_rho": weighted_quantile(
                S_over_rho[good],
                outward[good],
            ),
            "lambda_min_over_rho": weighted_quantile(
                ratios[..., 0][good],
                outward[good],
            ),
            "lambda_mid_over_rho": weighted_quantile(
                ratios[..., 1][good],
                outward[good],
            ),
            "lambda_max_over_rho": weighted_quantile(
                ratios[..., 2][good],
                outward[good],
            ),
            "anisotropy_over_rho": weighted_quantile(
                anisotropy[good],
                outward[good],
            ),
            "dec_ratio": weighted_quantile(
                dec_ratio[good],
                outward[good],
            ),
        },
    }

    def zone_stats(mask):
        selected = (
            mask
            & good
        )

        energy = float(
            np.sum(
                cell_energy[selected]
            )
        )

        force = float(
            np.sum(
                outward[selected]
            )
        )

        return {
            "energy_fraction": (
                energy
                / max(E, 1.0e-300)
            ),
            "gross_outward_fraction": (
                force
                / max(
                    gross_out,
                    1.0e-300,
                )
            ),
            "S_over_rho": weighted_quantile(
                S_over_rho[selected],
                cell_energy[selected],
            ),
            "lambda_min_over_rho": weighted_quantile(
                ratios[..., 0][selected],
                cell_energy[selected],
            ),
            "lambda_mid_over_rho": weighted_quantile(
                ratios[..., 1][selected],
                cell_energy[selected],
            ),
            "lambda_max_over_rho": weighted_quantile(
                ratios[..., 2][selected],
                cell_energy[selected],
            ),
            "dec_ratio": weighted_quantile(
                dec_ratio[selected],
                cell_energy[selected],
            ),
        }

    f90_zone = zone_stats(
        f_masks[90]
    )
    scaffold_zone = zone_stats(
        ~f_masks[90]
    )

    return {
        "E": E,
